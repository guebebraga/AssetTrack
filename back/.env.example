
# Cadena de conexión directa o pooler de Supabase.
# Para el pooler transaccional usar el puerto 6543 y agregar ?pgbouncer=true
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Auth
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional: si el proyecto usa claves asimétricas.
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Organización por defecto para la primera instalación.
DEFAULT_ORGANIZATION_ID=org-default
DEFAULT_ORGANIZATION_NAME=Sanatorio Modelo

# Clave para que los lectores RFID puedan enviar lecturas sin JWT de usuario.
DEVICE_API_KEY=cambiar-esta-clave

# Solo para desarrollo local. Nunca activar en producción.
AUTH_DISABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_ROLE=admin

# Crear tablas automáticamente al iniciar (útil solo en desarrollo).
AUTO_CREATE_TABLES=false
AUTO_BOOTSTRAP=true

# CORS separado por comas. Para móvil no es necesario, para web sí.
CORS_ORIGINS=*
